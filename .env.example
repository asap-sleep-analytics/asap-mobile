# Use 127.0.0.1 when running iOS simulator on the same machine.
# Use 10.0.2.2 for Android emulator.
# Use your LAN IP when testing on a physical device.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# --- Login social (opcional) ---
# Client IDs de Google OAuth 2.0 desde Google Cloud Console.
# Usa el Client ID de tipo "Android" (con tu SHA-1), "iOS" y "Web" respectivamente.
# Si usas Expo Go/web, añade también el "Expo" client id que expone expo-auth-session.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
